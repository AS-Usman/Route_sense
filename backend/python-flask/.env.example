# RouteSense — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.

# ─── Supabase / PostgreSQL ───────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI (mode: Session)
DATABASE_URL=postgresql://postgres:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres

# ─── Flask ───────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key

# ─── CORS (optional) ─────────────────────────────────────────────────────────
# Set to 1 to allow all origins (useful for Railway deployment)
# CORS_ALLOW_ALL=1

# ─── Frontend URL (optional, comma-separated) ────────────────────────────────
# FRONTEND_URL=https://your-custom-domain.com

